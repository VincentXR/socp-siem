{
  "realm": "socp",
  "enabled": true,
  "sslRequired": "none",
  "loginTheme": "keycloak",
  "clients": [
    {
      "clientId": "socp-backend",
      "name": "SOCP 机机客户端（client-credentials）",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "change-me-in-prod",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "role-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "role",
            "claim.value": "analyst",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "tenant-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant",
            "claim.value": "socp",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "socp-spa",
      "name": "SOCP 前端 SPA（PKCE）",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*", "http://localhost:18092/*"],
      "webOrigins": ["+"],
      "protocolMappers": [
        {
          "name": "role-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "role",
            "claim.value": "analyst",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "tenant-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant",
            "claim.value": "socp",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "soc_analyst",
      "enabled": true,
      "email": "analyst@socp.local",
      "emailVerified": true,
      "firstName": "Analyst",
      "lastName": "SOCP",
      "credentials": [{ "type": "password", "value": "Socp@2026", "temporary": false }],
      "realmRoles": ["soc_analyst"]
    }
  ],
  "roles": {
    "realm": [
      { "name": "soc_analyst" },
      { "name": "admin" }
    ]
  }
}
