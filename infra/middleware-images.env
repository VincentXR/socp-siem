# SOCP middleware image catalog.
#
# This file is the single version source for the local Compose stack, CI
# middleware, Testcontainers integration tests, and the failure probes. Keep
# image references fixed: use a release tag or a sha256 digest, never
# `latest`.
SOCP_POSTGRES_IMAGE=postgres:18
SOCP_KAFKA_IMAGE=apache/kafka:4.0.0
SOCP_OPENSEARCH_IMAGE=opensearchproject/opensearch:2.19.6
SOCP_OPENSEARCH_DASHBOARDS_IMAGE=opensearchproject/opensearch-dashboards:2.19.6
SOCP_REDIS_IMAGE=redis:8
SOCP_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.3
# Built locally by Compose from the upstream source commit containing the
# GHSA-jjjj-jwhf-8rgr fix; the old community image is only the runtime base.
SOCP_MINIO_IMAGE=socp/minio:source-9e49d5e7a648
SOCP_MINIO_BUILD_IMAGE=golang:1.26.8-bookworm
SOCP_MINIO_BASE_IMAGE=quay.io/minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
SOCP_TEMPORAL_IMAGE=temporalio/auto-setup:1.24.0
SOCP_TEMPORAL_UI_IMAGE=temporalio/ui:2.26.0
SOCP_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0
SOCP_PROMETHEUS_IMAGE=prom/prometheus@sha256:508729e0e2d18e11fd742a5a5ca70e557b940a93948c3c95fd0123a6fd538b69
SOCP_GRAFANA_IMAGE=grafana/grafana@sha256:ab5cb380e3ff3172d6c8bd2e7cfd31cce977d2881b260e1f5bc089bf0b759b43
SOCP_LOKI_IMAGE=grafana/loki:3.5.0
SOCP_JAEGER_IMAGE=jaegertracing/all-in-one@sha256:ab6f1a1f0fb49ea08bcd19f6b84f6081d0d44b364b6de148e1798eb5816bacac

# Non-runtime fixtures used by focused integration tests and collection.
SOCP_PROXY_FIXTURE_IMAGE=nginx:1.27-alpine
SOCP_VECTOR_IMAGE=timberio/vector:0.57.0-alpine
