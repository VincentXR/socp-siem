<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.socp</groupId>
        <artifactId>socp-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>detect-web</artifactId>
    <name>DetectWeb</name>
    <description>DETECT Web（检测规则/匹配引擎，GASP8）</description>

    <dependencies>
        <!-- 服务间调用统一客户端（超时/状态码检查/失败可见/指标/trace 透传） -->
        <dependency>
            <groupId>com.socp.platform</groupId>
            <artifactId>socp-client</artifactId>
        </dependency>

    <dependency>
            <groupId>com.socp.platform</groupId>
            <artifactId>socp-error</artifactId>
        </dependency>
        <dependency>
            <groupId>com.socp.platform</groupId>
            <artifactId>socp-tenant</artifactId>
        </dependency>
        <dependency>
            <groupId>com.socp.platform</groupId>
            <artifactId>socp-audit</artifactId>
        </dependency>
        <!-- 规则引擎共享库（com.siem 迁移） -->
        <dependency>
            <groupId>com.socp.platform</groupId>
            <artifactId>socp-rule</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 规则持久化（2026-08-10）：H2 文件库 + JPA + Flyway，规则重启不丢 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.socp.platform</groupId>
            <artifactId>socp-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.socp.platform</groupId>
            <artifactId>socp-obs</artifactId>
        </dependency>
        <dependency>
            <groupId>com.socp.platform</groupId>
            <artifactId>socp-ratelimit</artifactId>
        </dependency>
        <dependency>
            <groupId>com.socp.platform</groupId>
            <artifactId>socp-data</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 事件总线接线：消费 Kafka socp-events 主题（SEARCH 采集产物 → 规则引擎） -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>3.9.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
