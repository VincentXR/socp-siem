# shellcheck shell=bash
# =============================================================================
# SOCP 服务端口唯一来源（single source of truth）
# =============================================================================
# 以前端口表散落在 run-all.sh / run-slice.sh / verify-full.py / wait_health.py /
# vite.config.ts / gateway application.yml 六个地方，改一个端口要连锁改六个文件。
# 现在只有这一份，其余全部引用它：
#
#   bash   : source "<repo>/build/ports.env"   -> 得到 SOCP_PORT_* 变量与 socp_port/socp_ctx 函数
#   python : import ports (build/ports.py)     -> 解析本文件，得到同一张表
#   前端   : vite 只认网关端口（SOCP_GATEWAY_PORT），不再维护 17 条代理
#   网关   : application.yml 里各下游 URI 支持环境变量覆盖
#
# 覆盖方式：任何 SOCP_PORT_* 都可以被同名环境变量覆盖（本文件用 ${VAR:-默认} 写法）。
#   例：SOCP_PORT_ALERT_WEB=28080 bash build/run-all.sh backend
#
# context-path 规则：api-gateway 挂根路径（空 context），其余服务 context-path == 服务名。
#   健康检查：网关 /actuator/health，业务服务 /<服务名>/actuator/health
# =============================================================================

# 启动顺序即数组顺序（网关放最后，等下游先就绪）
# Default deployment processes. Collection ingress now runs inside asset-web/hips-web.
SOCP_SERVICE_NAMES="alert-web search-config detect-web soar-web report-web asset-web soc-base hips-web ai-assistant detect-model threat-web attack-web notify-web incident-web api-gateway"

# All executable Maven service modules, including optional compatibility launchers.
SOCP_MODULE_NAMES="alert-web search-config detect-web soar-web report-web asset-web soc-base hips-web ai-assistant detect-model asset-collect hips-collect threat-web attack-web notify-web incident-web api-gateway"

SOCP_PORT_ALERT_WEB="${SOCP_PORT_ALERT_WEB:-18080}"
SOCP_PORT_SEARCH_CONFIG="${SOCP_PORT_SEARCH_CONFIG:-18081}"
SOCP_PORT_DETECT_WEB="${SOCP_PORT_DETECT_WEB:-18082}"
SOCP_PORT_SOAR_WEB="${SOCP_PORT_SOAR_WEB:-18083}"
SOCP_PORT_REPORT_WEB="${SOCP_PORT_REPORT_WEB:-18084}"
SOCP_PORT_ASSET_WEB="${SOCP_PORT_ASSET_WEB:-18085}"
SOCP_PORT_SOC_BASE="${SOCP_PORT_SOC_BASE:-18086}"
SOCP_PORT_HIPS_WEB="${SOCP_PORT_HIPS_WEB:-18087}"
SOCP_PORT_AI_ASSISTANT="${SOCP_PORT_AI_ASSISTANT:-18088}"
SOCP_PORT_DETECT_MODEL="${SOCP_PORT_DETECT_MODEL:-18090}"
SOCP_PORT_ASSET_COLLECT="${SOCP_PORT_ASSET_COLLECT:-18091}"
SOCP_PORT_API_GATEWAY="${SOCP_PORT_API_GATEWAY:-18092}"
SOCP_PORT_HIPS_COLLECT="${SOCP_PORT_HIPS_COLLECT:-18093}"
SOCP_PORT_THREAT_WEB="${SOCP_PORT_THREAT_WEB:-18094}"
SOCP_PORT_ATTACK_WEB="${SOCP_PORT_ATTACK_WEB:-18095}"
SOCP_PORT_NOTIFY_WEB="${SOCP_PORT_NOTIFY_WEB:-18096}"
SOCP_PORT_INCIDENT_WEB="${SOCP_PORT_INCIDENT_WEB:-18097}"

# 前端 dev server（单一控制台，侧边栏切模块）
SOCP_PORT_FRONTEND_WORKBENCH="${SOCP_PORT_FRONTEND_WORKBENCH:-5173}"

# -----------------------------------------------------------------------------
# 统一北向入口：前端代理 / 服务间调用换 token / 验证脚本登录，都走这个地址。
# 服务拓扑（谁在哪个端口）只有网关知道，别的模块一律只认 SOCP_GATEWAY_URL。
# -----------------------------------------------------------------------------
SOCP_GATEWAY_URL="${SOCP_GATEWAY_URL:-http://localhost:${SOCP_PORT_API_GATEWAY}}"

# 采集链路鉴权：search-config ingest 的机机 token，须与渲染给 Vector 的 Authorization 头一致
export SOCP_VECTOR_TOKEN="${SOCP_VECTOR_TOKEN:-dev-vector-token}"

# -----------------------------------------------------------------------------
# bash 辅助函数（source 本文件后可用）
# -----------------------------------------------------------------------------

# socp_port <service-name>  -> 端口号
socp_port() {
  local key
  key="SOCP_PORT_$(printf '%s' "$1" | tr 'a-z-' 'A-Z_')"
  printf '%s' "${!key:-}"
}

# socp_ctx <service-name>   -> context-path（api-gateway 为空）
socp_ctx() {
  [ "$1" = "api-gateway" ] && return 0
  printf '%s' "$1"
}

# socp_health_url <service-name> -> 健康检查完整 URL
socp_health_url() {
  local name="$1" port ctx
  port="$(socp_port "$name")"
  ctx="$(socp_ctx "$name")"
  if [ -z "$ctx" ]; then
    printf 'http://localhost:%s/actuator/health' "$port"
  else
    printf 'http://localhost:%s/%s/actuator/health' "$port" "$ctx"
  fi
}

# -----------------------------------------------------------------------------
# 服务间调用地址：默认全部指向各自端口，可整体改指 Docker/K8s 内的 service 名。
# 业务代码里的 @Value("${socp.xxx.url:...}") 只读这些环境变量，不再写死 localhost:18080。
# -----------------------------------------------------------------------------
export SOCP_ALERT_URL="${SOCP_ALERT_URL:-http://localhost:${SOCP_PORT_ALERT_WEB}}"
export SOCP_SEARCH_URL="${SOCP_SEARCH_URL:-http://localhost:${SOCP_PORT_SEARCH_CONFIG}}"
export SOCP_DETECT_URL="${SOCP_DETECT_URL:-http://localhost:${SOCP_PORT_DETECT_WEB}}"
export SOCP_SOAR_URL="${SOCP_SOAR_URL:-http://localhost:${SOCP_PORT_SOAR_WEB}}"
export SOCP_REPORT_URL="${SOCP_REPORT_URL:-http://localhost:${SOCP_PORT_REPORT_WEB}}"
export SOCP_ASSET_URL="${SOCP_ASSET_URL:-http://localhost:${SOCP_PORT_ASSET_WEB}}"
export SOCP_HIPS_URL="${SOCP_HIPS_URL:-http://localhost:${SOCP_PORT_HIPS_WEB}}"
export SOCP_THREAT_URL="${SOCP_THREAT_URL:-http://localhost:${SOCP_PORT_THREAT_WEB}}"
export SOCP_ATTACK_URL="${SOCP_ATTACK_URL:-http://localhost:${SOCP_PORT_ATTACK_WEB}}"
export SOCP_NOTIFY_URL="${SOCP_NOTIFY_URL:-http://localhost:${SOCP_PORT_NOTIFY_WEB}}"
export SOCP_INCIDENT_URL="${SOCP_INCIDENT_URL:-http://localhost:${SOCP_PORT_INCIDENT_WEB}}"
export SOCP_GATEWAY_URL

# 网关路由下游（application.yml 中的占位符）
export SOCP_SSA_URI="${SOCP_SSA_URI:-$SOCP_ALERT_URL}"
export SOCP_GLS_URI="${SOCP_GLS_URI:-$SOCP_SEARCH_URL}"
export SOCP_GAS_WEB_URI="${SOCP_GAS_WEB_URI:-$SOCP_DETECT_URL}"
export SOCP_SOAR_URI="${SOCP_SOAR_URI:-$SOCP_SOAR_URL}"
export SOCP_SFM_URI="${SOCP_SFM_URI:-$SOCP_REPORT_URL}"
export SOCP_SAM_WEB_URI="${SOCP_SAM_WEB_URI:-$SOCP_ASSET_URL}"
export SOCP_SOC_URI="${SOCP_SOC_URI:-http://localhost:${SOCP_PORT_SOC_BASE}}"
export SOCP_HIPS_WEB_URI="${SOCP_HIPS_WEB_URI:-$SOCP_HIPS_URL}"
export SOCP_AI_URI="${SOCP_AI_URI:-http://localhost:${SOCP_PORT_AI_ASSISTANT}}"
export SOCP_GAS_MODEL_URI="${SOCP_GAS_MODEL_URI:-http://localhost:${SOCP_PORT_DETECT_MODEL}}"
export SOCP_SAM_COLLECT_URI="${SOCP_SAM_COLLECT_URI:-$SOCP_ASSET_URL}"
export SOCP_HIPS_COLLECT_URI="${SOCP_HIPS_COLLECT_URI:-$SOCP_HIPS_URL}"
export SOCP_TI_URI="${SOCP_TI_URI:-$SOCP_THREAT_URL}"
export SOCP_ATTACK_URI="${SOCP_ATTACK_URI:-$SOCP_ATTACK_URL}"
export SOCP_NOTIFY_URI="${SOCP_NOTIFY_URI:-$SOCP_NOTIFY_URL}"
export SOCP_CASE_URI="${SOCP_CASE_URI:-$SOCP_INCIDENT_URL}"

# -----------------------------------------------------------------------------
# 特性开关：全链路 trace 上报（OpenTelemetry → Jaeger OTLP 4317）。
# 默认关闭——核心 8 件套不含 Jaeger（它在 extra profile），开着会在 Jaeger 不可达时
# 被 BatchSpanProcessor 的导出失败刷满 ERROR 日志。需要链路可视化时置 true 并起 Jaeger。
# -----------------------------------------------------------------------------
export SOCP_TRACING_ENABLED="${SOCP_TRACING_ENABLED:-false}"
