<?xml version="1.0" encoding="UTF-8"?>
<!--
  SOCP 构建专用 Maven settings（仅本项目使用，通过 mvn -s 指定，不修改用户全局 ~/.m2/settings.xml）
  作用：把 Maven Central 换成国内镜像。实测中央仓库 ~5 kB/s，阿里云 ~12 MB/s。
  用法：mvn -s socp/build/settings-mirror.xml <goals>
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">

  <mirrors>
    <mirror>
      <id>aliyun-public</id>
      <name>Aliyun Public (mirrors central + jcenter + spring 等)</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>

  <profiles>
    <profile>
      <id>socp-repos</id>
      <repositories>
        <!-- Spring 里程碑/快照版本不在 central，单独走阿里云 spring 仓 -->
        <repository>
          <id>aliyun-spring</id>
          <url>https://maven.aliyun.com/repository/spring</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>aliyun-plugin</id>
          <url>https://maven.aliyun.com/repository/public</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>socp-repos</activeProfile>
  </activeProfiles>
</settings>
