{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "images",
    "runtime",
    "workloads"
  ],
  "properties": {
    "images": {
      "type": "object",
      "required": [
        "apiGateway",
        "searchConfig",
        "detectWeb",
        "alertWeb"
      ],
      "additionalProperties": false,
      "properties": {
        "apiGateway": {
          "$ref": "#/definitions/image"
        },
        "searchConfig": {
          "$ref": "#/definitions/image"
        },
        "detectWeb": {
          "$ref": "#/definitions/image"
        },
        "alertWeb": {
          "$ref": "#/definitions/image"
        },
        "soarWeb": {
          "$ref": "#/definitions/image"
        },
        "reportWeb": {
          "$ref": "#/definitions/image"
        },
        "assetWeb": {
          "$ref": "#/definitions/image"
        },
        "socBase": {
          "$ref": "#/definitions/image"
        },
        "hipsWeb": {
          "$ref": "#/definitions/image"
        },
        "aiAssistant": {
          "$ref": "#/definitions/image"
        },
        "threatWeb": {
          "$ref": "#/definitions/image"
        },
        "attackWeb": {
          "$ref": "#/definitions/image"
        },
        "notifyWeb": {
          "$ref": "#/definitions/image"
        },
        "incidentWeb": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "existingSecret",
        "gatewaySigningSecret",
        "metricsSecret",
        "config",
        "detectionPartitions"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "gatewaySigningSecret": {
          "type": "string",
          "minLength": 1
        },
        "metricsSecret": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object"
        },
        "extraConfig": {
          "type": "object"
        },
        "detectionPartitions": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "prometheusRule": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "additionalLabels": {
              "type": "object"
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "required": [
            "enabled",
            "interval",
            "scrapeTimeout",
            "bearerTokenSecretKey"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            "scrapeTimeout": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            "bearerTokenSecretKey": {
              "type": "string",
              "minLength": 1
            },
            "additionalLabels": {
              "type": "object"
            }
          }
        }
      }
    },
    "workloads": {
      "type": "object",
      "required": [
        "api-gateway",
        "search-config-api",
        "search-config-worker",
        "detect-web-api",
        "detect-web-worker",
        "alert-web"
      ]
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^@\\s]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    }
  }
}
