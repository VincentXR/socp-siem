# ---- Maven / Java ----
**/target/
.m2/
*.class
*.jar
*.war
*.original

# ---- 前端 ----
frontend/node_modules/
frontend/**/node_modules/
frontend/dist/
frontend/**/dist/
frontend/**/tsconfig.tsbuildinfo
frontend/**/playwright-report/
frontend/**/test-results/
.pnpm-store/
frontend/.pnpm-store/

# ---- IDE ----
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# ---- 本地运行残留 ----
*.log
*.mv.db
.trace.db
.cache/
docs/_local/
infra/docker-compose.override.yml
*.pid

# ---- 系统 ----
.DS_Store
Thumbs.db

# ---- 环境变量/密钥（如后续添加 .env 类文件） ----
.env
*.local
# 例外：build/ports.env 是端口表（唯一来源），必须入库，不是本地密钥文件
!build/ports.env

# ---- 本机 CodeBuddy 工作文件（不上 GitHub） ----
CODEBUDDY.md

# ---- 工具链 junction（指向本机 D 盘 tooling，仓库内不跟踪） ----
tooling/

# ---- 本机临时目录（helm 渲染、junit、下载的工具等） ----
# 与 Terraform 无关：删掉 AWS 交付栈时它被一并删了，于是这个通用目录
# 变成了未忽略状态，一次 git add -A 就会把本机产物带进仓库。
.tmp/

# ---- Python 缓存 ----
__pycache__/
*.pyc
